n = input ('Digite algo : ')
print (' O tipo primitivo desse valor é : ', type(n) )
print ('só tem espaços?', n.isspace())
print ('somente numeros? ', n.isnumeric())
print ('Alfanumerico  ? ', n.isalnum())
print ('contem apenas letras ?' , n.isalpha())
print ('letras maiusculas ?', n.isupper())
print ('Letras minusculas ?', n.islower())
print ('esta capitalizadad? ', n.istitle())
print('Decimal?', n.isdecimal())
